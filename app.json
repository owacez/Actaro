{
  "expo": {
    "name": "Actaro",
    "slug": "actaro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "actaro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.actaro.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.actaro.app",
      "adaptiveIcon": {
        "backgroundColor": "#f4f0e8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Actaro to record your route while you run.",
          "locationAlwaysAndWhenInUsePermission": "Allow Actaro to continue recording an active run when the screen is locked. Location recording stops when you pause, finish or discard the run.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Actaro to read today's step count for your activity log."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f0e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "frequentUpdates": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Allow Actaro to read your weight, height, sex, date of birth, workouts and resting heart rate to set up your plan. Actaro does not write to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4ba1469-cb68-4ce0-973a-627524e2dbc8"
      }
    },
    "owner": "chmuhammadowais"
  }
}
