{
  "expo": {
    "name": "Actaro",
    "slug": "actaro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "actaro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.actaro.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.actaro.app",
      "adaptiveIcon": {
        "backgroundColor": "#f4f0e8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Actaro to read today's step count for your activity log."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f0e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4ba1469-cb68-4ce0-973a-627524e2dbc8"
      }
    },
    "owner": "chmuhammadowais"
  }
}
