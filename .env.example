# Copy to the ignored .env file and use the project API URL (not its dashboard URL).
# Get both values from Supabase's Connect dialog. Restart Expo after changes.
# EXPO_PUBLIC values are bundled into the app and must never contain secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------------
# Backend setup only (npm run setup:backend). Server-only values: never prefix them
# with EXPO_PUBLIC_, never add them to EAS app environments or app code.
# See docs/SELF_HOSTING.md for where to find each value.

# Secret (service) key used by the dataset importers.
SUPABASE_SECRET_KEY=

# Postgres connection string used to apply migrations. Percent-encode the password.
# Supabase Cloud: Connect > Session pooler URI. Self-hosted: your Postgres URI.
SUPABASE_DB_URL=

# Optional, Supabase Cloud only: a personal access token (Account > Access Tokens) lets
# setup deploy the delete-account function and add sign-in redirect URLs for you.
SUPABASE_ACCESS_TOKEN=

# Optional sign-in settings. Defaults suit local web development on port 8081.
# Add your phone's Expo Go callback (exp://<computer-ip>:8081/--/auth/callback) or a
# production web origin here, comma separated.
ACTARO_AUTH_SITE_URL=
ACTARO_AUTH_REDIRECT_URLS=

# Never commit database passwords, privileged keys or AI provider secrets.
