# Reserved for the later v0.1 Supabase integration task; unused by the starter.
# Copy to .env only when integration is authorized and project values exist.
# EXPO_PUBLIC values are bundled into the app and must never contain secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put Supabase service-role keys, database passwords, or AI provider
# secrets in this file or any EXPO_PUBLIC variable.
