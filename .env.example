# Copy to the ignored .env file and use the project API URL (not its dashboard URL).
# Get both values from Supabase's Connect dialog. Restart Expo after changes.
# EXPO_PUBLIC values are bundled into the app and must never contain secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional LOCAL administrative import only. Leave blank for ordinary app use.
# Put a real value only in ignored .env, never in this template or EAS app envs.
# The mobile application must never import this value or use an EXPO_PUBLIC name.
SUPABASE_SECRET_KEY=

# Never commit database passwords, privileged keys or AI provider secrets.
